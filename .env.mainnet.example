# Remiglo MAINNET production environment.
#
# Copy to .env.mainnet on the production host, fill in the real values,
# and keep that copy OUTSIDE git. Never commit a filled copy.
#
# The server does NOT read .env files by itself (there is no dotenv in
# this codebase). Export these variables into the process environment:
# systemd EnvironmentFile=, or `set -a; . ./.env.mainnet; set +a` in the
# start script. Every variable below is read by the code (verified
# against src/server.ts, src/server-app.ts, src/services/intents.ts and
# src/services/webhooks.ts on 2026-11-12).
#
# Two variables from earlier drafts are deliberately ABSENT because the
# code does not read them:
#   HOST            src/server.ts binds 127.0.0.1 unconditionally. Put a
#                   same host reverse proxy (Caddy or nginx) in front
#                   for HTTPS; see docs/MAINNET-RUNBOOK.md section 6.
#   PUBLIC_BASE_URL Nothing in the code reads it. Invoice payment links
#                   are relative (/pay/<id>) today, so the domain comes
#                   from the reverse proxy, not from a setting.

# Runtime mode. The code only checks this is not "test" (it gates the
# background poller and indexer timers in src/server.ts).
NODE_ENV=production

# HTTP port the server listens on, on 127.0.0.1 (default 8400).
PORT=8400

# Admin token guarding merchant creation and internal routes. Generate
# a long random value, for example: openssl rand -hex 32
ADMIN_TOKEN=replace-with-a-long-random-token

# SQLite database file. Use an absolute path on persistent, backed up
# disk (the store runs SQLite in WAL mode; back up with sqlite3 .backup,
# see the runbook). The parent directory must exist.
REMIGLO_DB=/var/lib/remiglo/remiglo.db

# --- NEAR Intents 1Click -------------------------------------------------

# Partner API key from partners.near-intents.org. Required for the app
# fee split; without it quotes still work but Remiglo earns no fee.
ONECLICK_API_KEY=<redacted_query_secret_1>

# ONECLICK_BASE_URL: leave UNSET in production. The code defaults to
# https://1click.chaindefuser.com (mainnet). NEVER point production at
# a testnet sandbox (for example Tidepool): customers would be handed
# testnet deposit addresses for real money.
#ONECLICK_BASE_URL=

# 1Click call timeout in ms (default 45000) and the longer quote budget
# (default 120000). The defaults are fine; uncomment only to tune.
#ONECLICK_TIMEOUT_MS=45000
#ONECLICK_QUOTE_TIMEOUT_MS=120000

# INTENTS_MOCK must NEVER be set in production. "1" swaps the real
# 1Click client for a deterministic fake that settles nothing.
#INTENTS_MOCK=

# --- App fee (confirmed 50 bps, paid to remiglo.near) --------------------

# App fee in basis points, sent to 1Click as appFees on every quote.
APP_FEE_BPS=50

# NEAR account that receives the fee share. Must be remiglo.near once
# that mainnet account exists.
APP_FEE_RECIPIENT=remiglo.near

# --- Pilot safety limits -------------------------------------------------

# Per payout cap in smallest units (this is also the code default:
# 100000000 = 100 USDC). Raise in steps per the runbook, together with
# the on chain policy.
PILOT_MAX_PAYOUT_UNITS=100000000

# Batch totals above this need an explicit approval before quoting, in
# smallest units (this is also the code default: 500000000 = 500 USDC).
APPROVAL_THRESHOLD_UNITS=500000000

# --- Registry contract anchoring and indexing ----------------------------

# The registry contract account on mainnet.
REGISTRY_CONTRACT_ID=remiglo.near

# Full access key file for remiglo.near, in NEAR JSON key format. Read
# by the server to sign batch anchors. Relative paths resolve from the
# server working directory; keys/ is gitignored and this file must
# never be committed. Restrict it: chmod 600.
REGISTRY_KEY_FILE=keys/remiglo.near.json

# The NEAR account the registry contract knows as the merchant. The
# signer in REGISTRY_KEY_FILE must be an admin of this merchant on
# chain (the deploy script registers remiglo.near with itself as admin).
REGISTRY_MERCHANT_ACCOUNT=remiglo.near

# Network name. The indexer uses it to pick its default RPC when
# NEAR_RPC_URL is unset; set it so nothing can fall back to testnet.
REGISTRY_NETWORK=mainnet

# NEAR RPC endpoint for anchoring, views and indexing.
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com

# Optional archival RPC for deep registry event indexing. Leave unset
# unless the indexer needs history beyond the regular RPC window.
#NEAR_ARCHIVAL_RPC_URL=

# --- Background loops and webhooks ---------------------------------------

# Status poller interval in seconds (default 15, 0 disables). Keep the
# default in production: invoice and payout states advance through it.
POLL_SECONDS=15

# Dedicated registry indexer interval in seconds (default 0 = the
# indexer still ticks inside every poller cycle). Leave at 0.
INDEXER_SECONDS=0

# Webhook delivery attempts before giving up (default 5) and the first
# retry backoff in ms, doubling per attempt (default 1000).
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_MS=1000

# --- Chain Signatures treasury module (optional, normally off) -----------
# Read by src/services/chainSignatures.ts but inert unless enabled.
# Remiglo's settlement does not need it (NEAR Intents handles its own
# flow). Leave all three unset for the mainnet launch.
#CHAIN_SIG_ENABLED=
#CHAIN_SIG_KEY_FILE=
#CHAIN_SIG_NETWORK=
