# Remiglo example environment. Copy to .env and fill in your own values.
# Every value below is intentionally BLANK. Never commit a real key.

# Admin token that protects merchant creation and internal sync (optional but recommended)
ADMIN_TOKEN=

# SQLite database path (default ./data/remiglo.db)
REMIGLO_DB=

# NEAR Intents 1Click partner API key (from partners.near-intents.org, needed for the fee split)
ONECLICK_API_KEY=
ONECLICK_BASE_URL=

# Set to 1 to run fully offline with the deterministic fake intents client
INTENTS_MOCK=

# App fee in basis points (default 30) and the NEAR account that receives the fee share
APP_FEE_BPS=
APP_FEE_RECIPIENT=

# Pilot safety cap per payout, in smallest units (default 100000000 = 100 USDC)
PILOT_MAX_PAYOUT_UNITS=

# Batch approval threshold in smallest units (default 500000000 = 500 USDC)
APPROVAL_THRESHOLD_UNITS=

# Webhook delivery retries and first backoff in milliseconds (defaults 5 and 1000)
WEBHOOK_MAX_ATTEMPTS=
WEBHOOK_BACKOFF_MS=

# Poller interval in seconds (default 15, 0 disables)
POLL_SECONDS=

# HTTP port (default 8400)
PORT=

# Registry anchoring (Slice G): the Remiglo Registry contract account,
# the key file of a merchant admin signer, and the NEAR account id the
# contract knows as the merchant. All three engage live anchoring.
REGISTRY_CONTRACT_ID=
REGISTRY_KEY_FILE=
REGISTRY_MERCHANT_ACCOUNT=

# NEAR RPC endpoint (default https://rpc.testnet.near.org)
NEAR_RPC_URL=

# Registry indexer interval in seconds (Slice I, default 0 = off)
INDEXER_SECONDS=

# Chain Signatures treasury module (Slice H): set to 1 to enable, with
# the path to the NEAR account key file that owns the treasury account
CHAIN_SIG_ENABLED=
CHAIN_SIG_KEY_FILE=
CHAIN_SIG_NETWORK=
